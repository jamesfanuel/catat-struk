# Pilih SALAH SATU cara di bawah ini, lalu isi nilainya dan import ke Vercel
# (Vercel Dashboard -> Project Settings -> Environment Variables -> Import .env)

# === WAJIB UNTUK LOGIN DATABASE DI VERCEL (PILIH SALAH SATU) ===
# Opsi A: Supabase (PostgreSQL Gratis) - jalankan db/schema.sql di SQL Editor Supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Opsi B: Neon Postgres (Gratis di Vercel Marketplace) - jalankan db/schema.sql
# NEON_DATABASE_URL=postgres://...
# === MODE ENVIRONMENT ===
# Di development (`npm run dev`), AUTH_SECRET boleh dikosongkan (otomatis pakai dev secret).
# Di production (Vercel), AUTH_SECRET WAJIB diisi!
APP_ENV=production

# === WAJIB DI PRODUCTION (OPSIONAL DI DEVELOPMENT) ===
AUTH_SECRET=ganti_dengan_string_acak_panjang
# DATA_ENCRYPTION_KEY=opsional_kunci_terpisah_untuk_enkripsi_database
ADMIN_PASSWORD=ganti_dengan_password_admin

# === OPSIONAL: PENGIRIMAN EMAIL HTML (Resend API atau otomatis fallback ke Apps Script MailApp) ===
# Daftar gratis di https://resend.com (3.000 email/bulan)
# RESEND_API_KEY=re_...
# EMAIL_FROM="CatatStruk <onboarding@resend.dev>"

# === WAJIB UNTUK SCAN STRUK OTOMATIS (SEMUA USER) ===
# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === CARA 1 (Paling Mudah & 100% Gratis): Google Apps Script Bridge ===
# Deploy google-apps-script/Code.gs sebagai Web App (Who has access: Anyone)
APPS_SCRIPT_BRIDGE_URL=

# === CARA 2 (Alternatif Google Cloud Service Account - Gratis) ===
# Ambil dari file JSON Service Account Google Cloud Console
# GOOGLE_CLIENT_EMAIL=catatstruk-bot@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
